# RheumaTrack environment variables
# Copy this file to .env.local and fill in the values. .env.local is git-ignored.
#
# ── Option 1: local development with the Firebase Emulator Suite (no Firebase account) ──
# `npm run dev:local` sets VITE_USE_EMULATORS=true for you; nothing else is needed.
# VITE_USE_EMULATORS=true
# Optional overrides if you changed the emulator ports in firebase.json:
# VITE_EMULATOR_AUTH_URL=http://127.0.0.1:9099
# VITE_EMULATOR_FIRESTORE_HOST=127.0.0.1
# VITE_EMULATOR_FIRESTORE_PORT=8080
#
# ── Option 2: a real Firebase project ──
# Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration.
# These identify the project; they are not secrets (access is enforced by Security Rules),
# but keep them out of source control anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
#
# Optional: Firebase App Check with reCAPTCHA Enterprise (recommended for production).
# Leave empty to disable App Check.
VITE_APPCHECK_RECAPTCHA_ENTERPRISE_KEY=
#
# ── Server-side only (scripts/grant-clinician.ts) — NEVER prefix with VITE_ ──
# Path to a service-account JSON key for your project. Keep this file outside the project
# folder and never commit it. Not needed for the emulator.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/service-account.json
